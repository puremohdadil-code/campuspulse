# Browser requests use same-origin /api so httpOnly cookies work without CORS
# differences between localhost and 127.0.0.1.
VITE_API_URL=/api
 
# Local Vite proxy target. This is not exposed to browser JavaScript.
# Deployed backend: https://hackathon-server-gjzz.onrender.com
# Local backend:    http://localhost:3000
BACKEND_TARGET=https://hackathon-server-gjzz.onrender.com
